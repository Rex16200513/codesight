{
  "name": "@codesight/mcp-server",
  "version": "0.9.0",
  "type": "module",
  "bin": {
    "codesight-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "start:http": "node --experimental-strip-types src/index.ts --http",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test src/server.test.ts"
  },
  "dependencies": {
    "@codesight/core": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.8.2"
  }
}
